# Sao chép file này thành .env rồi chỉnh nếu cần.
# Không đưa mật khẩu thật vào Git.

POSTGRES_USER=brewlite
POSTGRES_PASSWORD=brewlite
POSTGRES_DB=brewlite
POSTGRES_PORT=5432
PORT=3001

HEAD
# --- WEB (FE) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
# Công tắc Mock Sản phẩm (true: dùng dữ liệu mẫu trên máy dev; false hoặc bỏ trống: gọi API thật)
NEXT_PUBLIC_USE_MOCK_PRODUCTS=false
# Công tắc Mock Auth (true: dùng tài khoản giả lập trên máy dev; false hoặc bỏ trống: gọi API thật)
NEXT_PUBLIC_USE_MOCK_AUTH=false
# Công tắc Mock Đặt đơn & Thanh toán (true: dùng dịch vụ đơn hàng/thanh toán giả lập; false hoặc bỏ trống: gọi API thật)
NEXT_PUBLIC_USE_MOCK_ORDERS=false
=======
# Chuỗi kết nối database cho Prisma (khớp với thông tin PostgreSQL ở trên)
DATABASE_URL="postgresql://brewlite:brewlite@localhost:5432/brewlite?schema=public"

# --- API (BE) ---
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=
