# Sao chép file này thành .env rồi chỉnh nếu cần.
# Không đưa mật khẩu thật vào Git.

# --- DEPLOY (Dev&Ops) ---
# Production: Đặt các biến trên Render Dashboard và GitHub Secrets, không đặt secret trong file này.
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=brewlite
POSTGRES_DB=brewlite
POSTGRES_PORT=5432

PORT=3001

# Tham khảo các biến cho Pipeline CD (.github/workflows/cd.yml):
# PRODUCTION_API_URL=https://brewlite-api.onrender.com
# PRODUCTION_WEB_URL=https://brewlite-web.onrender.com
# RENDER_EXTERNAL_DATABASE_URL=
# RENDER_API_DEPLOY_HOOK=
# RENDER_WEB_DEPLOY_HOOK=

HEAD
# --- WEB (FE) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
# Công tắc Mock Sản phẩm (true: dùng dữ liệu mẫu trên máy dev; false hoặc bỏ trống: gọi API thật)
NEXT_PUBLIC_USE_MOCK_PRODUCTS=false
# Công tắc Mock Auth (true: dùng tài khoản giả lập trên máy dev; false hoặc bỏ trống: gọi API thật)
NEXT_PUBLIC_USE_MOCK_AUTH=false
# Công tắc Mock Đặt đơn & Thanh toán (true: dùng dịch vụ đơn hàng/thanh toán giả lập; false hoặc bỏ trống: gọi API thật)
NEXT_PUBLIC_USE_MOCK_ORDERS=false
=======
# Chuỗi kết nối database cho Prisma (khớp với thông tin PostgreSQL ở trên)
DATABASE_URL="postgresql://brewlite:brewlite@localhost:5432/brewlite?schema=public"

# URL của API khi build image frontend Web (phải là domain public khi deploy production)
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- API (BE) ---
CORS_ORIGIN=http://localhost:3000
JWT_SECRET=
TEST_DATABASE_URL="postgresql://brewlite:brewlite@127.0.0.1:5432/brewlite_test?schema=public"
# Mật khẩu cho 5 tài khoản demo khi chạy seed (tối thiểu 6 ký tự; không ghi mật khẩu thật vào Git)
DEMO_USER_PASSWORD=
