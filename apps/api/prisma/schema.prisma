generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Category {
  TEA
  COFFEE
  MILK_TEA
  CAKE
}

enum Role {
  CUSTOMER
  STAFF
  ADMIN
}

enum Size {
  S
  M
  L
}

enum SugarLevel {
  P0
  P30
  P50
  P70
  P100
}

enum IceLevel {
  NONE
  LOW
  NORMAL
  FULL
}

enum ReceiveType {
  AT_COUNTER
  TAKE_AWAY
}

enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY
  COMPLETED
  PAYMENT_FAILED
  CANCELLED
}

enum PaymentMethod {
  WALLET
  CARD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model Product {
  id         String      @id @default(uuid())
  name       String
  category   Category
  basePrice  Int
  imageUrl   String
  stock      Int         @default(0)
  isVisible  Boolean     @default(true)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  orderItems OrderItem[]
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  displayName  String
  role         Role      @default(CUSTOMER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  orders       Order[]
  payments     Payment[]
}

model Topping {
  id                String             @id @default(uuid())
  name              String
  price             Int
  isVisible         Boolean            @default(true)
  orderItemToppings OrderItemTopping[]
}

model Order {
  id          String      @id @default(uuid())
  orderNumber Int         @unique @default(autoincrement())
  userId      String
  status      OrderStatus @default(PENDING)
  receiveType ReceiveType @default(AT_COUNTER)
  note        String?
  totalAmount Int
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id])
  items       OrderItem[]
  payments    Payment[]

  @@index([userId])
}

model OrderItem {
  id          String             @id @default(uuid())
  orderId     String
  productId   String
  productName String
  unitPrice   Int
  quantity    Int
  size        Size?
  sugarLevel  SugarLevel?
  iceLevel    IceLevel?
  lineTotal   Int
  note        String?
  order       Order              @relation(fields: [orderId], references: [id])
  product     Product            @relation(fields: [productId], references: [id])
  toppings    OrderItemTopping[]

  @@index([orderId])
}

model OrderItemTopping {
  id          String    @id @default(uuid())
  orderItemId String
  toppingId   String
  name        String
  price       Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  topping     Topping   @relation(fields: [toppingId], references: [id])

  @@index([orderItemId])
}

model Payment {
  id             String        @id @default(uuid())
  orderId        String
  userId         String
  idempotencyKey String
  method         PaymentMethod
  accountLast4   String
  amount         Int
  status         PaymentStatus
  failureReason  String?
  createdAt      DateTime      @default(now())
  order          Order         @relation(fields: [orderId], references: [id])
  user           User          @relation(fields: [userId], references: [id])

  @@unique([userId, idempotencyKey])
  @@index([orderId])
  @@index([userId])
}
